def update_User_csv(csv_fname, rows):
    csv_row = rows.id+","+rows.name+","+rows.access
    if not file_exists(csv_fname):               # check file exsists. If not, create file and add header row
        try: 
            with open(csv_fname,"a", encoding = "utf-8") as file_handle:
                file_handle.write("id,name,access\n")
                file_handle.write(csv_row+"\n")
        except: print("An error occurred while attempting to open the file",csv_fname)
    else:
        try: 
            with open(csv_fname,"a", encoding = "utf-8") as file_handle: file_handle.write(csv_row+"\n")
        except: print("An error occurred while attempting to open the file",csv_fname)
    return True

