def get_user_name():
    name = input("Please enter the user name : ").strip().title()
    valid=False
    while not valid:
        if not validate_str(name,"ABCDEFGHIJKLMNOPQRSTUVWXYZ -"):
            if name=="" or name==None or name[0].upper() not in "ABCDEFGHIJKLMNOPQRSTUVWXYZ": valid=False
            else: valid=True
            if valid==False:
                print("User name can only contain alpha characters and spaces - please try again")
                name = input("Please enter the user name (or leave blank to exit) : ").strip.title()
        else: valid=True
    return str(name.strip())
     
''' bool validate_str()
    Returns a boolean value of True for a valid string and False for an invalid string
    Accepts two argmuments; the first specifies the string to be validated and the second a string containing the characters allowed in the first.
    Arguments   : string - str which is the string to be validated
                : valid_chars - str containing all the characters allowed in the string
    Returns     : True for a valid string
                : False for an invalid string '''
def validate_str(string, valid_chars):
    try: return next((False for char in string if char.upper() not in valid_chars))
    except: return True

""" Returns the input if it's within the specifications
    Accepts a message to be displayed to the user and specifications to bound the input
    Specs can be True to only accept strings or False to only accpet integers, a list to accept only the elements in that list,
    or both, as a tuple containing True or False, and a list of accepted elements """
def validate_input(msg, spec):
    while True:
        action = input(msg)
        s = spec[0] if isinstance(spec, tuple) else spec     # if it's a tuple (True, ['', '']), extract the first element, # otherwise just set s to the spec
        if (s == 0 and action.isdigit()) or (s == 1 and action.isalpha()): return action  # int (False), str (True)
        valid = spec[1] if isinstance(spec, tuple) else spec
        try: 
            if action in valid: return action                       # action in list of accepted terms
        except: print("Input invalid. Please try again.")

def valid_access_level(access_level):
    access_level=access_level.strip()
    print(access_level)
    if len(access_level)>2 or access_level==None: return False
    if access_level in ["0123456789"] or access_level=="10": return True 
    else: return False

def handle_action(location):
    isbn = input("Please enter the ISBN or Title of the asset to borrow (or leave blank to exit): ")   # get input for isbn or title
    if isbn == "": return None
    if not isbn.isdigit():
        types = ['paperback', 'hardcover', 'digital', 'audio']
        media = validate_input(f"Please enter the media of the asset ({', '.join(types)} or leave blank to exit): ", types).capitalize()   # get input for isbn or title
        if media == "": return None
    else: media = ""
    details = valid_book(isbn, media, location)
    if details is None: print("Book doesn't exist") if location == lib_assets else print("Book doesn't exist in user's borrowed books"); return None
    isbn = isbn if isbn.isdigit() else details[0].isbn     # convert isbn to integer if it was given as a title
    return (isbn, media, details if len(details) > 1 else details[0])

def User_login():
    logged_in = False                # used to indicate if a user was able to successfully login into an account
    while not logged_in:
        try:
            name = get_user_name().title()      # Get the user's name
            if not User.login_exists(name): print("Name not found...please contact your supervisor for user account creation")
            else:
                logged_user = User.get_user_obj(name)
                return logged_user
        except KeyboardInterrupt: return None

