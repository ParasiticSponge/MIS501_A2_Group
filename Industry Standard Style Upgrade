def dump(csv_fname, lst, fields):
    try:
        file_handle = open(csv_fname,"w",encoding="utf-8")       # create empty file
        file_handle.write(fields+"\n") # combine all the elements in the list into a string and separate them by comma
    except: print("An error occurred while attempting to open the file :",csv_fname); return False
    for row in lst:
        csv_row = ",".join([str(x) for x in list(vars(row).values()) if x != 0])+"\n"   # get all the values such as title, author, etc with vars() (make sure they are strings), then combine all the elements in the list into a string and separate them by comma
        file_handle.write(csv_row)
    file_handle.close()

