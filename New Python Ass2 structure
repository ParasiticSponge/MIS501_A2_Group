        name = input("Please enter your name (or leave blank to exit) : ")
    return str(name)
     
'''
bool validate_str()
Returns a boolean value of True for a valid string and False for an invalid string
Accepts two argmuments; the first specifies the string to be validated and the second 
a string containing the characters allowed in the first.
Arguments   : string - str which is the string to be validated
            : valid_chars - str containing all the characters allowed in the string

Returns     : True for a valid string
            : False for an invalid string

'''
def validate_str(string, valid_chars):
    for char in string:
        if char.upper() not in valid_chars:
            return False
    return True                

