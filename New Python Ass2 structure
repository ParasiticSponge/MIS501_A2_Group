class Borrower(Collection):
    def __init__(self, id, name):
        super().__init__(id, name)
        self.books_on_loan = 0              # numnber of items student has on loan
        all_borrowers[id] = self

    def __str__(self):
        return f"""
                 Name : {self.name}
           Student ID : {self.id}
        Books on loan : {self.books_on_loan}
        """
    
    """
    obj select_borrower()
    Prompts the user for the borrower's Student ID and returns the borrower as an object class Borrower
    """
    # TODO could use decorators or smth to remove repetition
    def select_borrower():
        input_stud_id = input("Please enter the Student ID of the borrower (or leave blank to exit): ")
        if input_stud_id == "": return None 
        if input_stud_id in all_borrowers: return all_borrowers[input_stud_id]  # return an existing borrower object if the student ID is already in the all_borrowers dictionary
        else:
            name = input("Please enter the name of the student: ")              # Prompt the user for the name of the student if the student ID is not already in the all_borrowers dictionary
            print(f"Student {name} registered to database\n")
            return Borrower(input_stud_id, name)
    def select_returner():
        input_stud_id = input("Please enter the Student ID of the borrower (or leave blank to exit): ")
        if input_stud_id == "": return None 
        if input_stud_id in all_borrowers: return all_borrowers[input_stud_id]  # return an existing borrower object if the student ID is already in the all_borrowers dictionary
        else: return None

class Book(Borrower):
    # Self initialisation learned through W3schools: https://www.w3schools.com/python/python_class_init.asp
    def __init__(self, id, name, isbn, period=None):
        super().__init__(id, name)
        self.isbn = isbn                           # ISBN of book. This is a unique identifier for each book.
        if period is None: self.period = 14
        else: self.period = period                 # Borrowing period for the book.
        self.borrowed = today
        self.due = calculate_due_date(today, self.period)
        all_borrowers[id].books_on_loan+=1
        borrowed_books.append(self)

    def return_book(self):
        self.returned = today
        all_borrowers[self.id].books_on_loan-=1
        if all_borrowers[self.id].books_on_loan == 0: del all_borrowers[self.id]          # If the student has no more books on loan, remove them from the all_borrowers dictionary.
        borrowed_books.remove(self)                      # Remove the book from the borrowed_books list. This is done to keep track of which books are currently borrowed and which are not.
        
    def is_overdue(self):
        return (self.due > today)

