""" clear_screen()
    Clears the user console screen using the appropriate OS system clear screen commands
        nt identifies Windows OS - uses cls, anything else identifies Mac or Linux - uses clear
    Arguments: None
    Returns: None
"""
def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')    # call correct OS clear screen function using os.system to identify OS - nt for windows, otherwise OS is Mac or Linux
    return

"""
int days_in_month(month,year)
Returns an integer value of the number of days in the month passed as an int and year passed as an int - if year is not passed then leap year not taken into account
Arguments
    month : int
    year  : int - year passed so month == 2 will return 29 for leap years and 28 for other years
          : None - year not passed so month == 2 will return 28

Returns   : int value of the number of days in month
"""
def days_in_month(month, year=None):
    days_in_months = [31,28,31,30,31,30,31,31,30,31,30,31]
    days = days_in_months[month-1]
    if year!=None and (is_leap_year(year) and month==2) : days+=1
    return days

"""
bool is_leap_year(year)
Returns a boolean value, either True for leap year or False for normal year
Arguments
    year : int value representing the year
Returns
    True for leap year False for normal year
"""
def is_leap_year(year):
    return year % 4 == 0 and (year % 400 !=0 and year % 100 !=0 )       # Return True for leap year and False for normal year

""" 
str calculate_due_date(borrow_date, period)
Calculates the due date of a borrowed book, returning the due date as a string in the format YYYY-MM-DD 
Arguments
    borrow_date : Str in the format YYYY-MM-DD
    period      : Int value of the borrowing period in days.
Returns         : str containing date calculated using loan period and borrow_date
"""
def calculate_due_date(borrow_date, period):
    year, month, day = map(int, borrow_date.split("-"))  # Split the borrow date into year, month, and day. Convert them to integers.
    day += period                                       # Add the borrowing period to the day.
    while day > days_in_month(month, year):               # While the day is greater than the number of days in the month, subtract the number of days in the month from the day and increment the month. If the month is greater than 12, increment the year and set the month to 1.
        day -= days_in_month(month, year)
        month += 1
        if month > 12:
            month = 1
            year += 1
    return f"{year}-{month:02d}-{day:02d}"             # Return the due date in the format YYYY-MM-DD. The :02d formats the month and day to be two digits with leading zeros if necessary.

def valid_book(isbn: str):
    if isbn.isdigit(): 
        isbn = int(isbn)
        found = [book for book in lib_catalogue if isbn in vars(book).values()] # checks if the isbn is in any of the parameter values
    elif isbn.isalpha(): found = [book for book in lib_catalogue if book.title == isbn]
    try:
        attributes = [value if value == isbn else None for attr, value in vars(found[0]).items()][2:] # loop through the parameters and values of the found book. By default all of it's ISBNs are active because it came from the library catalog. Only get the attribute if it matches the given ISBN, otherwise set it to None
        return Asset(found[0].author, found[0].title, *attributes)
    except: return None

def book_by_stud(stud_id, isbn):
    for book in borrowed_books:
        if book.id == stud_id and book.isbn == isbn: return book
    return None

def print_borrower_book_list(borrowed_books):
        """ Prints all the books a user has borrowed. It prints the due date rather than the days left, as the due date is more useful to the user. """        
        for borrower in borrowed_books:                                     # For each key in the user's borrowed books (For each ISBN int)
            details = valid_book(borrower.isbn)                             # Get the book details for the ISBN
            book_type = [param for param, value in vars(details).items() if value != None][-1] # get the media type where the ISBN is valid and not None. Author and name auto are valid, so get last parameter. (also unpack it as first is param and second is value)
            print(f"User: {borrower.name}, ID: {borrower.id}, Type: {book_type},  " +
                  f"ISBN: {borrower.isbn}, Title: {details.title},{' ' * (minTitleLength - len(details.title))}" +   # Print the key (ISBN), the title of the book, the author of the book, and the due date. The due date is calculated with the current date and the borrowing period from the brrwd dictionary value
                  f"Author: {details.author},{' ' * (minAuthorLength - len(details.author))}" + 
                  f"Due Date: {borrower.due}")    
    
def print_library_catalogue():
        """ Function that prints all the books in the library collection. """
        for book in lib_catalogue:
            for name, value in vars(book).items():          # iterate through each attribute of the book object (title, author, paperback, hardcover, digital)
                if name in ("title", "author"): continue    # skip author and title so it's just the media types
                if value is not None:
                    print(f"ISBN: {value}, Type: {name}," +
                          f"Title: {book.title},{' ' * (minTitleLength - len(book.title))}" +   # The same as print_user_book_list(), but instead of the due date, it prints the borrowing period. This is more useful for library staff to calculate the due date for each user. It also shows users how long they can borrow a book.
                          f"Author: {book.author},{' ' * (minAuthorLength - len(book.author))}")

def print_overdue_report():   # Overdue book report across all students
    overdue = [book for book in borrowed_books if book.is_overdue()]        # get a list of books only if they are overdue
    print_borrower_book_list(overdue)                                       # print them out

