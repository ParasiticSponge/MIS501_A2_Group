class User:

    def __init__(self, name, staff_id=None, access=0):
        self.name = name                 # User's name.
        self.staff_id = staff_id         # User's year of birth.
        self.access = access             # Staff access level: level 0 : adds and removes books : level 10 - Superuser (creates users)
        all_users.append(self)
        
    def __str__(self):
        return f"""
                    User name : {self.name}
                     Staff ID : {self.staff_id}
                 Access level : {self.access}
                """
    """ 
    obj create_user(name)
    Superuser function to create a user for accessing the Library Management System
    Arguments
        name    : str : user name to be created
    Returns         
        obj     : obj : containing newly created user login
    """
    def create_user(name=None):
        """ Allows a user to sign up for the library system. If users sign up, they should automatically be logged in. """
        if name == None:
            name = input("Please enter your name: ")
        staff_id = input("Please enter your Staff ID or Guest: ")
        access = input("Please select staff access level : ")
        logged_user = User(name, staff_id, access)
        return logged_user
    
    """ 
    bool login_exists(name)
    Determines if the name supplied already exists and returns True or False
    Arguments
        name     : str : containing the user's name
    Returns         
        bool     : True if the name already exists
                 : False if the name doesn't exist
    """
    def login_exists(name):
        matching_object = next((obj for obj in all_users if obj.name == name), None)
        if matching_object:
            return True
        else:
            return False

    """ 
    obj login_exists(name)
    Returns boolean indicating if the name given exists already
    Arguments
        name     : str containing a user name
    Returns         
        bool     : True if the name already exists
                 : False if the name doesn't exist
    """
    def get_user_obj(name):
        return next((obj for obj in all_users if obj.name == name), None)


    """ 
    obj list_library_users()
    Prints a list of all of the defined LMS users
    Arguments
        N/A
    Returns         
        N/A
    """
    def list_library_users():
        """ Function that prints all the users in the library collection. """
        for user in all_users: print(user)          # Prints all the users in the library collection. It prints the user's name, year of birth, and contact information.

