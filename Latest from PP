def book_details(is_isbn_int, found, media=None, isbn=None):
    if is_isbn_int:
        attributes = [value if value == isbn else False for _, value in vars(found[0]).items()][2:] # loop through the parameters and values of the found book (exclude author and title by using list slicing so we get paperback, hardcover etc). By default all of it's ISBNs are active because it came from the library catalog. Only get the attribute if it matches the given ISBN, otherwise set it to None
        if sum(attributes) == 0: return None   # if all values are False (False has an int value of 0, so sum of all will = 0)
        return Asset(found[0].author, found[0].title, *attributes)     # two asterix mean assign key+value, one means assign value. Set the parameters to the values in the the attributes list. This means only one type of media will have it's ISBN active. Instead of returning a tuple (author, title, isbn), retain structure to print correct media type later (paperback, hardcover, etc).
    else:
        asset_media = vars(found[0])[media]                           # check the media type's ISBN of the book found. Since the found book is in the catalogue, there'll only be one book to check
        return Asset(found[0].author, found[0].title, **{media: asset_media}) if asset_media != None else None   # if there is no format available for that book, return None. get the value of the parameter in the object's inbuilt self dictionary that matches the input media type. Return none if format's ISBN isn't valid

