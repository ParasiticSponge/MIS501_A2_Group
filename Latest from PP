def monthly_borrowed_books_chart(borrowed_books):
    if not borrowed_books: print("No borrowing records found"); return
    data = [
        {"borrowed": book.borrowed}
        for book in borrowed_books
    ]
    df = pd.DataFrame(data)
    df["month"] = pd.to_datetime(df["borrowed"]).dt.strftime("%Y-%m")
    counts = df.groupby("month").size()
    axis = counts.plot(
        kind="bar",
        title="Books Borrowed By Month",
        xlabel="Month",
        ylabel="Number of Books Borrowed",
        color="steelblue"
    )
    axis.yaxis.set_major_locator(MaxNLocator(integer=True))
    plt.tight_layout()
    plt.savefig("BooksBorrowedMonthly.pdf",dpi=300)
    plt.show()
    print("Chart saved to local folder as BooksBorrowedMonthly.pdf")

def chart_borrowed_vs_not_borrowed():
    borrowed_isbns = {
        book.isbn
        for book in borrowed_books
        if book.returned == "" or book.returned is None
    }

    borrowed_count = len(borrowed_isbns)

    not_borrowed_count = sum(
        1 for asset in lib_assets
        if asset.isbn not in borrowed_isbns
    )

    plt.figure(figsize=(6, 6))
    plt.pie(
        [borrowed_count, not_borrowed_count],
        labels=["Borrowed", "Never Borrowed"],
        autopct="%1.1f%%",
        colors=["orange", "lightgreen"]
    )
    plt.title("Borrowed vs Available Assets")
    plt.savefig("BooksBorrowwedVNotBorrowed.pdf",dpi=300)
    plt.show()
    print("Chart saved to local folder as BooksBorrowwedVNotBorrowed.pdf")

