def load(csv_fname, num_fields, lst):
    print("eval" + csv_fname)
    if not file_exists(csv_fname): return False
    file_handle = open(csv_fname,"r", encoding = "utf-8")
    headings = file_handle.readline()               # get headings - the object identifiers
    csv_row = file_handle.readline()
    fields = []
    while csv_row != "":
        for i in range(num_fields): fields.append(get_csv_asset(csv_row, i))
        print(fields)
        this_class = Borrower(*fields) if csv_fname == BORROWERCSVFILE else Book(*fields) if csv_fname == BORROWEDBOOKSCSV else Asset(*fields) if csv_fname == ASSETCSVFILE else User(*fields) # create User object by passing the the variables from the fields list
        if lst != None: 
            try: lst.append(this_class)
            except: lst[fields[0]] = this_class      # field 0 is always ID
        fields.clear()                               # make sure to empty when done
        csv_row = file_handle.readline()        # get rows until EOF
    file_handle.close()
    print("success")

