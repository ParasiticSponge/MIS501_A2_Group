class Borrower(Collection):                 # Borrowers names and ids
    def __init__(self, id, name, loan=None):
        super().__init__(id, name)
        self.books_on_loan = loan if loan != None else 0              # numnber of items student has on loan
        all_borrowers.setdefault(id, self)

    def __str__(self):
        return f"""
                 Name : {self.name}
           Student ID : {self.id}
        Books on loan : {self.books_on_loan}
        """
    
    """
    obj select_borrower()
    Prompts the user for the borrower's Student ID and returns the borrower as an object class Borrower
    Arguments   : N/A
    Returns     : selected Borrower object
    """
    def select_borrower(func):
        def inner():
            input_stud_id = input("Please enter the Student ID of the borrower (or leave blank to exit): ").upper()
            if input_stud_id == "": return None 
            if input_stud_id in all_borrowers: return all_borrowers[input_stud_id]  # return an existing borrower object if the student ID is already in the all_borrowers dictionary
            else: return func(input_stud_id)    # execute the function depending on whether borrowing or returning
        return inner
    @select_borrower
    def id_borrowing(input_stud_id):
        name = input("Please enter the name of the student: ").title()              # Prompt the user for the name of the student if the student ID is not already in the all_borrowers dictionary
        print(f"Student {name} registered to database\n")
        return Borrower(input_stud_id, name)
    @select_borrower
    def id_returning(input_stud_id): return None if len(input_stud_id.strip()) == 0 else False  # empty strings return None whilst other IDs are invalid

class Book(Borrower):
    """
    __init__()
    Object creation method effectively borrows a book for the borrower
    Arguments   : id - Borrower Student ID
                : name - Student name
                : isbn - ISBN of the book borrowed
                : period - length of the loan period in days - defaults to 14 days if not supplied
    """
    def __init__(self, id, name, isbn, media, borrowed=None, due=None, returned=None, period=None):
        super().__init__(id, name)
        self.isbn = isbn                           # ISBN of book. This is a unique identifier for each book.
        self.media = media
        self.borrowed = borrowed if borrowed != None else today
        self.due = due if due != None else calculate_due_date(today, period if period != None else 14)
        self.returned = returned if returned != None else ""
        if borrowed == None: 
            all_borrowers[id].books_on_loan += 1   # if it's a new book being borrowed
            borrowed_books.append(self)

    """
    obj return_book()
    Returns the book borrowed by setting the returned date to current date
    Arguments   : N/A
    Returns     : selected Borrower object
    """
    def return_book(self):
        self.returned = today
        all_borrowers[self.id].books_on_loan-=1
        if all_borrowers[self.id].books_on_loan == 0: del all_borrowers[self.id]          # If the student has no more books on loan, remove them from the all_borrowers dictionary.
        borrowed_books.remove(self)                      # Remove the book from the borrowed_books list. This is done to keep track of which books are currently borrowed and which are not.

    """
    bool is_overdue(Book)
    Returns a boolean flag to indicate if the book object is overdue
    Arguments   : Book object
    Returns     : True if overdue or False if not overdue
    """
    def is_overdue(self): return (self.due > today)

